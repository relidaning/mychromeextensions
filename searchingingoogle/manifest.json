{
  "manifest_version": 3,
  "name": "Quick Google Search",
  "description": "Search selected text in Google with a shortcut.",
  "version": "1.1",
  "permissions": [
    "activeTab", "scripting", "clipboardRead"
  ],
  "host_permissions": [
    "http://127.0.0.1:27123/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "search-selected-text": {
      "suggested_key": {
        "default": "Ctrl+X"
      },
      "description": "Search selected text"
    },
    "search-selected-text-chinese": {
      "suggested_key": {
        "default": "Ctrl+Z"
      },
      "description": "Search selected text in Chinese"
    },
    "record-selected-text": {
      "suggested_key": {
        "default": "Ctrl+B"
      },
      "description": "Record selected text to Obsidian diary"
    }
  }
}
