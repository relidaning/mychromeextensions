{
  "manifest_version": 3,
  "name": "Video Speed Control",
  "version": "1.0",
  "description": "Alt+Up to speed up video playback, Alt+Down to slow it down. Also auto-skips YouTube ads.",
  "permissions": ["debugger"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
